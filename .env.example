# Postgres (docker compose, port 5433 because 5432 is taken on this machine)
ZERO_UPSTREAM_DB=postgres://postgres:pass@localhost:5433/triage
ZERO_REPLICA_FILE=/tmp/typeful-triage-zero.db
ZERO_PORT=4848
ZERO_QUERY_URL=http://localhost:3939/api/query
ZERO_MUTATE_URL=http://localhost:3939/api/mutate
ZERO_LOG_LEVEL=warn
# JWT signing secret for dev auth (HS256). The API verifies tokens itself; zero-cache just forwards them.
AUTH_SECRET=dev-secret-change-me
API_PORT=3939
# Secrets: never imported by apps/web
TYPESAFE_API_KEY=
GITHUB_TOKEN=
# Optional price config for the $ column (USD per million tokens)
TYPESAFE_PRICE_INPUT_PER_MTOK=
TYPESAFE_PRICE_OUTPUT_PER_MTOK=
