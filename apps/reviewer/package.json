{
  "name": "@triage/reviewer",
  "version": "0.0.0",
  "private": true,
  "description": "The guided-review environment: a celld cell that runs the pi SDK against the configured provider.",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=browser --target=es2022 --conditions=workerd,worker,browser --external:cloudflare:workers --external:node:* --sourcemap --outfile=dist/index.js",
    "dev": "esbuild src/index.ts --bundle --format=esm --platform=browser --target=es2022 --conditions=workerd,worker,browser --external:cloudflare:workers --external:node:* --sourcemap --outfile=dist/index.js --watch",
    "test": "vp test"
  },
  "dependencies": {
    "@arizeai/openinference-semantic-conventions": "^2.12.0",
    "@earendil-works/pi-ai": "^0.85.1",
    "@opentelemetry/api": "^1.9.1",
    "@triage/openinference-workers": "workspace:*",
    "@triage/triage": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260915.1",
    "esbuild": "^0.28.2",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
