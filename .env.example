# Postgres (docker compose maps the container to 5433 to leave a local Postgres on 5432 alone)
ZERO_UPSTREAM_DB=postgres://postgres:pass@localhost:5433/triage
ZERO_REPLICA_FILE=/tmp/typeful-triage-zero.db
ZERO_PORT=4848
ZERO_QUERY_URL=http://localhost:3939/api/query
ZERO_MUTATE_URL=http://localhost:3939/api/mutate
ZERO_LOG_LEVEL=warn
# Signs session tokens (HS256). The API verifies them itself; zero-cache just forwards them.
AUTH_SECRET=dev-secret-change-me
# Seals provider API keys at rest (System → Providers). Defaults to AUTH_SECRET; set your own
# in any shared deployment so rotating one does not expose the other.
CONFIG_SECRET=
API_PORT=3939
# Where the browser reaches the app; the GitHub OAuth callback is APP_URL/api/auth/github/callback.
APP_URL=http://localhost:5173

# Sign-in. Create a GitHub OAuth app (Settings → Developer settings → OAuth apps) with the
# callback above, then paste its id and secret. Comma-separated GitHub logins that are always
# admins; everyone else needs an invite from an admin (System → People).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ADMIN_GITHUB_LOGINS=

# Offline / agent-driven development: `vp run dev:emulate` starts the emulate.dev GitHub
# emulator and points sign-in at it (admin login "admin", token gho_test_token_admin) while
# sync keeps using real GitHub. To do the same by hand, set these:
# GITHUB_API_URL=http://localhost:4001          # sign-in lookups
# GITHUB_OAUTH_URL=http://localhost:4001        # OAuth authorize + token exchange
# GITHUB_SYNC_API_URL=https://api.github.com    # repository sync (defaults to GITHUB_API_URL)
# GITHUB_CLIENT_ID=emulated-client-id
# GITHUB_CLIENT_SECRET=emulated-client-secret

# The reviewer cell (apps/reviewer, celld in docker-compose.yml) that runs every guided review.
# `vp run dev` builds its bundle, starts it with compose and sets REVIEW_CELL_URL; without a
# reachable cell, generation is refused. The cell calls back into this API and reports traces
# from inside Docker, so those two addresses are as the container sees them.
# REVIEW_CELL_URL=http://127.0.0.1:9876
# REVIEW_CELL_API_URL=http://host.docker.internal:3939
# REVIEW_CELL_PHOENIX_URL=http://phoenix:6006
# REVIEWER_TOKEN=

# Arize Phoenix traces every guided review (jev requests, agent turns, tool calls, tokens, cost).
# `vp run dev` starts Phoenix from docker-compose.yml on http://localhost:7006 and sets this;
# leave it unset to send nothing.
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:7006
# PHOENIX_PROJECT_NAME=typeful-triage

# Secrets: never imported by apps/web
TYPESAFE_API_KEY=
# Server token used for syncing repositories (needed for pull requests and higher rate limits).
GITHUB_TOKEN=
# TypeSafe prices in USD per million tokens, shown as a to-date cost in the sidebar and System view.
# Current list price for jev; update if it changes.
TYPESAFE_PRICE_INPUT_PER_MTOK=0.042
TYPESAFE_PRICE_OUTPUT_PER_MTOK=0
